#!/usr/bin/expect -f
# Password login for the monitor on hosts that refuse keys (152.236.5.112).
#
#   pw-run.exp <user@host> <password-file> <command>
#
# The password is the 'senha:' line of <password-file>. It answers the SSH
# password prompt only (the monitor never uses sudo: a sudo prompt aborts).
# It is never printed: it is sent to ssh's own prompt, which does not echo.
# No pseudo-terminal is requested on the host. The exit status is the
# remote command's (64 usage, 65 login refused).
log_user 1
set timeout 120
if {[llength $argv] != 3} {
    puts stderr "usage: pw-run.exp <user@host> <password-file> <command>"
    exit 64
}
set target [lindex $argv 0]
set pwfile [lindex $argv 1]
set cmd [lindex $argv 2]
if {[catch {open $pwfile r} fh]} { puts stderr "pw-run.exp: cannot read the password file"; exit 64 }
set pw ""
while {[gets $fh line] >= 0} {
    if {[regexp -nocase {^senha:\s*(\S+)} $line -> value]} { set pw $value; break }
}
close $fh
if {$pw eq ""} { puts stderr "pw-run.exp: no 'senha:' line in the password file"; exit 64 }

spawn -noecho ssh -T -o PubkeyAuthentication=no -o PreferredAuthentications=password,keyboard-interactive \
    -o ConnectTimeout=15 -o ServerAliveInterval=15 -o NumberOfPasswordPrompts=1 $target $cmd
# Phase 1: until the password prompt (or the end: a host that let us in
# without one). Phase 2: only the end of the session, so nothing the probe
# prints can be taken for a prompt. A refused password makes ssh exit 255.
expect {
    -re {(?i)password: ?$} { send -- "$pw\r" }
    -re {\[sudo\] password} { puts stderr "\npw-run.exp: unexpected sudo prompt, aborting"; exit 65 }
    timeout { puts stderr "\npw-run.exp: no login prompt"; exit 65 }
    eof { set result [wait]; exit [lindex $result 3] }
}
expect {
    timeout { puts stderr "\npw-run.exp: timed out"; exit 65 }
    eof
}
set result [wait]
exit [lindex $result 3]
