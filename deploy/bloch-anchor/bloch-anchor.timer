# Each tick anchors only when Bloch finality advanced BLOCH_ANCHOR_EVERY_EPOCHS
# epochs past the last anchor (one Bloch epoch is ~16 min).
[Unit]
Description=Anchor the Bloch finalized checkpoint in GnB-SMH (periodic)

[Timer]
OnBootSec=5min
OnUnitInactiveSec=10min
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
