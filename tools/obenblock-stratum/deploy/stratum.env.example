# /etc/obenblock/stratum.env for obenblock-stratum.service (README.md, "Configuration").
# Values in <ANGLE BRACKETS> are launch placeholders: fill them at launch.

# The address every block pays (solo pool). REQUIRED.
OBB_STRATUM_PAYOUT_ADDRESS=<OWNER_OBB1_PAYOUT_ADDRESS>

OBB_STRATUM_NETWORK=mainnet
OBB_STRATUM_LISTEN=0.0.0.0:3333
OBB_STRATUM_METRICS=127.0.0.1:9333

# The local node's RPC (ObenBlock mainnet default port 18210) and its API key
# (the node's --rpc-api-key-file; getblocktemplate and submitblock need it).
OBB_STRATUM_RPC=127.0.0.1:18210
OBB_STRATUM_RPC_API_KEY_FILE=/etc/obenblock/rpc.key

# Starting share difficulty and vardiff band. 65536 suits one ASIC of
# 10-100 TH/s; miners may override with the password "d=<difficulty>".
OBB_STRATUM_DIFFICULTY=65536
OBB_STRATUM_DIFFICULTY_MIN=0.001
OBB_STRATUM_SHARE_SECS=10

# Accept any username (rental marketplaces that rewrite it). The payout
# never depends on the username.
OBB_STRATUM_ANY_USER=off

# PPLNS accounting (no payouts): 0 = off.
OBB_STRATUM_PPLNS_WINDOW=0

OBB_STRATUM_MAX_PER_IP=64
RUST_LOG=info
